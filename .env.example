# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://myuser:mypass@localhost:5432/mydb?schema=public"

# ── Auth.js / NextAuth ────────────────────────────────────────────────────────
# Generate a secure secret using: npx auth secret
AUTH_SECRET="your-super-secret-auth-key-change-me"

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── S3 / Object Storage (document uploads) ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL_S3=
S3_BUCKET_NAME=documents

# ── Cron jobs ─────────────────────────────────────────────────────────────────
# Used in Authorization: Bearer <secret> header on /api/cron/* routes
CRON_SECRET=
# Set to "true" in production to enable actual data deletion on trial expiry
ENABLE_TRIAL_PURGE=false

# ── Supabase (if used) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
