// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  branches     Branch[]
  loanProducts LoanProduct[]
  members      Member[]
  subscription Subscription?
  memberDocuments MemberDocument[]
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  password       String?
  name           String?
  role           Role          @default(USER)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  accounts       Account[]
  sessions       Session[]

  @@index([organizationId])
}

enum LoanType {
  QUICK
  BUSINESS
  MICRO
}

enum LoanStatus {
  PENDING
  ACTIVE
  SETTLED
  DEFAULTED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RepaymentMethod {
  CASH
  BANK_TRANSFER
  ACCOUNT_TRANSFER
}

model Branch {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  address        String?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  centres   Centre[]
  cashFlows CashFlow[]
}

model Centre {
  id           String   @id @default(cuid())
  centreNumber Int
  centreCode   String   @unique
  name         String
  isMicro      Boolean  @default(false)
  branchId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id])
  members  Member[]

  @@index([branchId])
}

model Member {
  id             String   @id @default(cuid())
  memberNumber   String
  name           String
  nic            String?
  address        String?
  contact1       String?
  contact2       String?
  groupNumber    Int?
  centreId       String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  centre       Centre       @relation(fields: [centreId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  loans        Loan[]
  guarantorFor Guarantor[]
  documents    MemberDocument[]

  @@unique([memberNumber, organizationId])
  @@index([centreId])
  @@index([nic])
  @@index([organizationId])
}

model LoanProduct {
  id              String   @id @default(cuid())
  name            String
  loanType        LoanType
  numberOfWeeks   Int
  multiplier      Decimal  @db.Decimal(10, 4) @default(1.17)
  isActive        Boolean  @default(true)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loans Loan[]

  @@unique([name, organizationId])
  @@index([organizationId])
}

model Loan {
  id                  String             @id @default(cuid())
  memberId            String
  loanProductId       String?
  loanType            LoanType
  loanNumber          String?
  loanAmount          Decimal            @db.Decimal(12, 2)
  weeklyRental        Decimal            @db.Decimal(10, 2)
  numberOfWeeks       Int
  totalReceivable     Decimal            @db.Decimal(12, 2)
  grantedDate         DateTime?          @db.Date
  expireDate          DateTime?          @db.Date
  status              LoanStatus         @default(ACTIVE)
  verificationStatus  VerificationStatus @default(PENDING)
  verificationNote    String?
  totalPaid           Decimal            @db.Decimal(12, 2) @default(0)
  outstanding         Decimal            @db.Decimal(12, 2)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  member      Member      @relation(fields: [memberId], references: [id])
  loanProduct LoanProduct? @relation(fields: [loanProductId], references: [id])
  repayments  LoanRepayment[]
  guarantors  Guarantor[]
  repaymentSchedule RepaymentSchedule[]

  @@index([memberId])
  @@index([loanType])
  @@index([status])
  @@index([grantedDate])
}

enum ScheduleStatus {
  PENDING
  DUE
  PAID
  PARTIALLY_PAID
  MISSED
  WAIVED
}

model LoanRepayment {
  id               String          @id @default(cuid())
  loanId           String
  instalmentNumber Int?            
  scheduledDate    DateTime?       @db.Date
  paidDate         DateTime        @db.Date
  amount           Decimal         @db.Decimal(10, 2)
  method           RepaymentMethod @default(CASH)
  note             String?
  collectedBy      String?         
  createdAt        DateTime        @default(now())

  loan Loan @relation(fields: [loanId], references: [id])

  @@index([loanId])
  @@index([paidDate])
}

model Guarantor {
  id           String   @id @default(cuid())
  loanId       String
  memberId     String?
  name         String?
  nic          String?
  contact      String?
  relationship String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  loan   Loan    @relation(fields: [loanId], references: [id])
  member Member? @relation(fields: [memberId], references: [id])

  @@index([loanId])
  @@index([memberId])
}

model RepaymentSchedule {
  id               String   @id @default(cuid())
  loanId           String
  instalmentNumber Int
  scheduledDate    DateTime @db.Date
  scheduledAmount  Decimal  @db.Decimal(10, 2)
  isPaid           Boolean  @default(false)
  status           ScheduleStatus @default(PENDING)
  paidAmount       Decimal  @db.Decimal(10, 2) @default(0)
  createdAt        DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id])

  @@index([loanId])
  @@index([scheduledDate])
}

model CashFlow {
  id              String   @id @default(cuid())
  branchId        String
  date            DateTime @db.Date
  centreName      String
  loanType        LoanType
  loansIssued     Int      @default(0)
  amountIssued    Decimal  @db.Decimal(14, 2) @default(0)
  dcAmount        Decimal  @db.Decimal(14, 2) @default(0)
  recoveryAmount  Decimal  @db.Decimal(14, 2) @default(0)
  totalRecovery   Decimal  @db.Decimal(14, 2) @default(0)
  interestAmount  Decimal? @db.Decimal(14, 2)
  capitalAmount   Decimal? @db.Decimal(14, 2)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, date, centreName, loanType])
  @@index([branchId, date])
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String
  maxOfficerSeats Int
  maxBranches     Int
  storageQuotaMb  Int
  monthlyPrice    Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIAL
  PENDING_VERIFICATION
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

model Subscription {
  id               String             @id @default(cuid())
  organizationId   String             @unique
  planId           String
  status           SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id])
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  paymentClaims PaymentClaim[]
}

enum PaymentClaimStatus {
  PENDING
  VERIFIED
  REJECTED
}

model PaymentClaim {
  id                       String             @id @default(cuid())
  subscriptionId           String
  amount                   Decimal            @db.Decimal(10, 2)
  bankReference            String
  paidDate                 DateTime           @db.Date
  proofUrl                 String?
  status                   PaymentClaimStatus @default(PENDING)
  reviewNote               String?
  submittedAt              DateTime           @default(now())
  verifiedAt               DateTime?
  verifiedByPlatformAdminId String?

  subscription Subscription   @relation(fields: [subscriptionId], references: [id])
  verifiedBy   PlatformAdmin? @relation(fields: [verifiedByPlatformAdminId], references: [id])
}

enum MemberDocumentType {
  NIC_PHOTO
  PAYSLIP
  BANK_BOOK
  OTHER
}

model MemberDocument {
  id             String             @id @default(cuid())
  organizationId String
  memberId       String
  type           MemberDocumentType
  url            String
  sizeBytes      Int
  uploadedAt     DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id])

  @@index([organizationId])
  @@index([memberId])
}

model PlatformAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  totpSecret String?
  totpEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs     PlatformAdminAuditLog[]
  paymentClaims PaymentClaim[]
}

model PlatformAdminAuditLog {
  id              String   @id @default(cuid())
  platformAdminId String
  action          String
  targetType      String
  targetId        String
  note            String?
  createdAt       DateTime @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id])

  @@index([platformAdminId])
  @@index([targetType, targetId])
}

// --- Auth.js Models (DB Sessions) ---
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  timestamp DateTime @default(now())

  @@index([email, timestamp])
  @@index([ip, timestamp])
}
